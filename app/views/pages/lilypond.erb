<h2>Lilypond</h2>

<textarea id="lily-code" class="lily-code"></textarea>
<input type="button" onclick="update();" value="Submit">
<div id="render"></div>
<b>Message count: </b><span id="message-count">0</span><br>
<b>File count: </b><span id="file-count">0</span>

<script>
  const minimal = "\\version \"2.14.1\"\n\\include \"english.ly\"\n\n\\score {\n  \\new Staff {\n    \\key d \\major\n    \\numericTimeSignature\n    \\time 2/4\n    <cs' d'' b''>16 <cs' d'' b''>8.\n    %% Here: the tie on the D's looks funny\n    %% Too tall? Left-hand endpoint is not aligned with the B tie?\n    ~\n    <cs' d'' b''>8 [ <b d'' a''> ]\n  }\n}"

  const codeElement = document.getElementById("lily-code");
  codeElement.value = minimal;

  let typeTimeout = null;
  codeElement.addEventListener('keyup', function (e) {
      clearTimeout(typeTimeout);

      typeTimeout = setTimeout(function() {
          update();
      }, 2000);
  });

  codeElement.addEventListener('keydown', function(e) {
      if (e.key == "Tab") {
          e.preventDefault();

          const start = this.selectionStart;
          const end = this.selectionEnd;

          this.value = this.value.substring(0,start) + "\t" + this.value.substring(end);

          this.selectionStart = this.selectionEnd = start + 1;
      }
  });

  let socket = new WebSocket("ws://localhost:2000");
  socket.onopen = function(e) {
      update();
  };

  const renderElement = document.getElementById("render");

  let messageCount = 0;

  socket.onmessage = function(event) {
      messageCount += 1;
      document.getElementById("message-count").innerHTML = messageCount;
      const data = JSON.parse(event.data);
      if ("result" in data && "files" in data.result && data.result.files.length > 0) {
          const fileCount = data.result.files.length;
          document.getElementById("file-count").innerHTML = fileCount;
          render.textContent = "";
          for (let file in data.result.files) {
              let view = document.createElement("img");
              view.src = "data:image/png;base64," + data.result.files[file];
              view.onload = function() {
                this.style = "width:" + 0.5*this.width + "px;"
              }
              render.appendChild(view);
          }
      } else if ("result" in data && "err" in data.result) {
          render.textContent = data.result.err
      } else {
          alert(event.data);
      }
  }

  function update() {
      const id = "id" + Math.random().toString(16).slice(2)
      let message = {
          params: {
              format: "png",
              crop: true,
              src: codeElement.value,
              version: "stable",
          },
          method: "render",
          id: id,
      };
      
      socket.send(JSON.stringify(message));
  };

  socket.onclose = function(event) {
      if (event.wasClean) {
          // Closed cleanly
      } else {
          // Closed abruptly
      }
  };

  socket.onerror = function(error) {
      // Errored
      alert(`Got ${error}`)
  };
</script>
